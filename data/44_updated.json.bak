  "content": [
    {
      "txt": "너희와 모든 "
    },
    {
      "txt": "이스라엘",
      "link": "60c71f046cfae70012b03764"
    },
    {
      "txt": " "
    },
    {
      "txt": "백성",
      "link": "60e19c269ca3f400122354c2"
    },
    {
      "txt": "들은 알라 <span style=\"color:crimson;\">¹</span>너희가 "
    },
    {
      "txt": "십자가",
      "link": "6145e6175f803400131d4a17"
    },
    {
      "txt": "에 "
    },
