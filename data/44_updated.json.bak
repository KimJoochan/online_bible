    },
    {
      "txt": "한 사람들이 많이 "
    },
    {
      "txt": "바울",
      "link": "60ba0e3b1376e50012a0da29"
    },
    {
      "txt": "과 "
    },
    {
      "txt": "바나바",
      "link": "60e5379ad73fa40012bc3bd0"
    },
    {
      "txt": "를 좇으니 두 "
    },
    {
      "txt": "사도",
      "link": "6152be53fca7a4001a586e0e"
    },
    {
      "txt": "가 더불어 말하고 항상 <span style=\"color:crimson;\">²</span>"
    },
    {
      "txt": "하나님",
      "link": "60ba24261376e50012a0da8a"
    },
    {
      "txt": "의 "
    },
    {
      "txt": "은혜",
      "link": "63ef8677155c55001474f73c"
    },
    {
      "txt": " 가운데 있으라 권하니라"
    }
  ],
