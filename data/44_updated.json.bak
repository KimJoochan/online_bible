  "content": [
    {
      "txt": "이 "
    },
    {
      "txt": "약속",
      "link": "61d6ee3921976e001389d958"
    },
    {
      "txt": "은 우리 열두 "
    },
    {
      "txt": "지파",
      "link": "61b74c623b8fc5001467ae49"
    },
    {
      "txt": "가 "
    },
    {
      "txt": "밤",
      "link": "639ddb9b6f82e7001484172b"
    },
    {
      "txt": "낮",
      "link": "62fb8d63f7b0360013928ede"
    },
    {
      "txt": "으로 간절히 "
    },
    {
      "txt": "하나님",
      "link": "60ba24261376e50012a0da8a"
    },
    {
      "txt": "을 받들어 "
    },
    {
      "txt": "섬김",
      "link": "63bd3ebf6f82e70014841b17"
    },
    {
