    {
      "txt": "베드로",
      "link": "611f08f2e8113c001ae0b4a8"
    },
    {
      "txt": "가 이것을 보고 "
    },
    {
      "txt": "백성",
      "link": "60e19c269ca3f400122354c2"
    },
    {
      "txt": "에게 말하되 "
