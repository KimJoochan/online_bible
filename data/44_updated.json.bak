  "content": [
    {
      "txt": "큰 "
    },
    {
      "txt": "분쟁",
      "link": "63d8c269155c55001474f51f"
    },
    {
      "txt": "이 생기니 "
    },
    {
      "txt": "천부장",
      "link": "646a1b8dba956c0013dc14bd"
    },
    {
      "txt": "이 "
    },
    {
      "txt": "바울",
      "link": "60ba0e3b1376e50012a0da29"
    },
    {
