  "content": [
    {
      "txt": "그 <span style=\"color:crimson;\">¹</span>"
    },
    {
      "txt": "눈",
      "link": "6303655bf7b0360013928f6b"
    },
    {
      "txt": "을 뜨게 하여 "
    },
    {
      "txt": "어두움",
      "link": "60ceba4d6cfae70012b03771"
    },
    {
      "txt": "에서 <span style=\"color:crimson;\">²</span>"
    },
    {
      "txt": "빛",
      "link": "60cf04bf6cfae70012b03774"
    },
    {
      "txt": "으로, <span style=\"color:crimson;\">³</span>"
    },
    {
      "txt": "사단",
      "link": "60ba185c1376e50012a0da35"
    },
    {
      "txt": "의 "
    },
