  "verse": 27,
  "content": [
    {
      "txt": "<span style=\"color:crimson;\">¹</span>"
    },
    {
      "txt": "바나바",
      "link": "60e5379ad73fa40012bc3bd0"
    },
    {
      "txt": "가 데리고 "
    },
    {
      "txt": "사도",
      "link": "6152be53fca7a4001a586e0e"
    },
    {
      "txt": "들에게 가서 그가 길에서 <span style=\"color:crimson;\">²</span>어떻게"
