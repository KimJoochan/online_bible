    },
    {
      "txt": "하여 "
    },
    {
      "txt": "선지자",
      "link": "6145de9d5f803400131d4a12"
    },
    {
      "txt": "들의 말을 응하게 하였도다"
    }
  ],
  "result": null,
  "deploy": "off",
