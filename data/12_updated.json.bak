      "link": "60bc51ec1376e50012a0db69"
    },
    {
      "txt": "의 앞에 앉은지라 "
    },
    {
      "txt": "엘리사",
      "link": "60bc51ec1376e50012a0db69"
    },
    {
      "txt": "가 자기 "
    },
    {
      "txt": "사환",
      "link": "6245d4788f55f400142199e1"
    },
    {
      "txt": "에게 이르되 큰 "
    },
    {
      "txt": "솥",
      "link": "63ac56dc6f82e7001484196e"
    },
    {
      "txt": "을 걸고 "
    },
    {
      "txt": "선지자",
      "link": "6145de9d5f803400131d4a12"
    },
    {
      "txt": "의 "
    },
    {
      "txt": "생도",
      "link": "63c4841e6f82e70014841bef"
    },
    {
      "txt": "들을 위하여 "
    },
    {
      "txt": "국",
      "link": "62a412b18f55f40014219c08"
    },
    {
      "txt": "을 끓이라 하매"
    }
  ],
