{
  "_id": {
    "$oid": "644395ffe73ff90013f3b15e"
  },
  "createdTs": null,
  "updatedTs": 1782125300,
  "updatedBy": "640989a122333e4cfb043150",
  "createdBy": null,
  "id": "644395ffe73ff90013f3b15e",
  "book": 12,
  "chapter": 18,
  "verse": 14,
  "content": [
    {
      "txt": "유다",
      "link": "618772baab886400139a72d3"
    },
    {
      "txt": " "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": " "
    },
    {
      "txt": "히스기야",
      "link": "60ba2b621376e50012a0daac"
    },
    {
      "txt": "가 라기스로 보내어 "
    },
    {
      "txt": "앗수르",
      "link": "614065eee8113c001ae0b561"
    },
    {
      "txt": " "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": "에게 이르되 내가 "
    },
    {
      "txt": "범죄",
      "link": "63a79d116f82e70014841895"
    },
    {
      "txt": "하였나이다 나를 떠나 돌아가소서 "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": "이 내게 지우시는 것을 내가 당하리이다 하였더니 "
    },
    {
      "txt": "앗수르",
      "link": "614065eee8113c001ae0b561"
    },
    {
      "txt": " "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": "이 곧 "
    },
    {
      "txt": "은",
      "link": "63f0cd8b155c55001474f781"
    },
    {
      "txt": " 삼백 "
    },
    {
      "txt": "달란트",
      "link": "623df6128f55f400142199b2"
    },
    {
      "txt": "와 금 삼십 "
    },
    {
      "txt": "달란트",
      "link": "623df6128f55f400142199b2"
    },
    {
      "txt": "를 정하여 "
    },
    {
      "txt": "유다",
      "link": "618772baab886400139a72d3"
    },
    {
      "txt": " "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": " "
    },
    {
      "txt": "히스기야",
      "link": "60ba2b621376e50012a0daac"
    },
    {
      "txt": "로 내게 한지라"
    }
  ],
  "result": null,
  "deploy": "off",
  "script": "유다 왕 히스기야가 라기스로 보내어 앗수르 왕에게 이르되 내가 범죄하였나이다 나를 떠나 돌아가소서 왕이 내게 지우시는 것을 내가 당하리이다 하였더니 앗수르 왕이 곧 은 삼백 달란트와 금 삼십 달란트를 정하여 유다 왕 히스기야로 내게 한지라",
