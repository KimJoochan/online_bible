    },
    {
      "txt": "을 찢으며 외치되 "
    },
    {
      "txt": "반역",
      "link": "64539d6dba956c0013dc1336"
    },
    {
      "txt": "이로다 "
    },
    {
      "txt": "반역",
      "link": "64539d6dba956c0013dc1336"
    },
    {
      "txt": "이로다 하매"
    }
  ],
  "result": null,
  "deploy": "off",
