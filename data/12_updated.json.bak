  "content": [
    {
      "txt": "칠월에 "
    },
    {
      "txt": "왕족",
      "link": "640347dccc90a400169b1fed"
    },
    {
      "txt": " "
    },
    {
      "txt": "엘리사마",
      "link": "63ea1b4b155c55001474f685"
    },
    {
      "txt": "의 "
    },
    {
      "txt": "손자",
      "link": "63ac0a7a6f82e70014841955"
    },
    {
      "txt": " "
    },
    {
      "txt": "느다니야",
