    },
    {
      "txt": "이 무론 노소하고 다 "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": "과 함께한지라 "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": "이 "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "의 전 안에서 발견한 "
    },
    {
      "txt": "언약",
      "link": "618a96f1c5894b001b8c5c28"
    },
    {
      "txt": "책",
      "link": "646a3593ba956c0013dc14c2"
    },
    {
      "txt": "의 모든 "
    },
    {
      "txt": "말씀",
      "link": "62356e018f55f4001421995c"
    },
    {
      "txt": "을 읽어 무리의 귀에 들리고"
    }
  ],
  "result": null,
  "deploy": "off",
