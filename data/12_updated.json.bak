  "book": 12,
  "chapter": 1,
  "verse": 4,
  "content": [
    {
      "txt": "그러므로 "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "의 "
    },
