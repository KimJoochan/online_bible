  "content": [
    {
      "txt": "만일 "
    },
    {
      "txt": "이스라엘",
      "link": "60c71f046cfae70012b03764"
    },
    {
      "txt": "이 나의 모든 명령과 나의 "
    },
    {
      "txt": "종",
      "link": "62296a218f55f40014219934"
    },
    {
      "txt": " "
