    },
    {
      "txt": "의 이 말은 "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "의 전에서는 저를 죽이지 말라 함이라"
    }
  ],
  "result": null,
  "deploy": "off",
