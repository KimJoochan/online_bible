      "link": "6300e45ef7b0360013928f3f"
    },
    {
      "txt": "이나 "
    },
    {
      "txt": "여종",
      "link": "63f5c974155c55001474f866"
    },
    {
      "txt": "을 받을 때냐"
    }
  ],
  "result": null,
