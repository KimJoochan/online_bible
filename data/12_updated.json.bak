    },
    {
      "txt": "을 세우되 마음을 다하고 "
    },
    {
      "txt": "성품",
      "link": "640ab5bc050c7b001378e7f9"
    },
    {
      "txt": "을 다하여 "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "를 "
    },
    {
      "txt": "순종",
      "link": "624424ad8f55f400142199d9"
    },
    {
      "txt": "하고 그 "
    },
    {
      "txt": "계명",
      "link": "623737358f55f40014219969"
    },
    {
      "txt": "과 "
    },
