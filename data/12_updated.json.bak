  "book": 12,
  "chapter": 9,
  "verse": 18,
  "content": [
    {
      "txt": "한 사람이 말을 타고 가서 만나 가로되 "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
