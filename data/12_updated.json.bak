    },
    {
      "txt": "에 보이는 신접한 자와 "
    },
    {
      "txt": "박수",
      "link": "63a854506f82e700148418ea"
    },
    {
      "txt": "와 "
    },
    {
      "txt": "드라빔",
      "link": "63299f476f82e700148411c2"
    },
    {
      "txt": "과 "
    },
    {
      "txt": "우상",
      "link": "60ba1f511376e50012a0da67"
    },
    {
      "txt": "과 모든 "
