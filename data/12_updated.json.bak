    {
      "txt": "을 취하여 성 위에서 "
    },
    {
      "txt": "번제",
      "link": "6140a056e8113c001ae0b562"
    },
    {
      "txt": "를 드린지라 "
    },
    {
      "txt": "이스라엘",
      "link": "60c71f046cfae70012b03764"
    },
    {
      "txt": "에게 크게 "
    },
    {
      "txt": "통분",
      "link": "647db2a1ba956c0013dc16d7"
    },
    {
      "txt": "함이 임하매 저희가 떠나 각기 고국으로 돌아갔더라"
    }
  ],
  "result": null,
