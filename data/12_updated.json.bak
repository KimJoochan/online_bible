    },
    {
      "txt": " 사람들은 "
    },
    {
      "txt": "네르갈",
      "link": "63089ffcf7b0360013928f80"
    },
    {
      "txt": "을 만들었고 "
    },
    {
      "txt": "하맛",
      "link": "6273b8928f55f40014219ac0"
    },
    {
      "txt": " 사람들은 "
    },
    {
      "txt": "아시마",
      "link": "63f44fce155c55001474f82e"
    },
    {
      "txt": "를 만들었고"
    }
  ],
  "result": null,
  "deploy": "off",
