  "content": [
    {
      "txt": "요시야",
      "link": "60babc971376e50012a0daf7"
    },
    {
      "txt": "가 또 "
    },
    {
      "txt": "유다",
      "link": "614341815f803400131d49d9"
    },
    {
      "txt": " 땅과 "
    },
    {
      "txt": "예루살렘",
