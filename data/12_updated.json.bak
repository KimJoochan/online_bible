{
  "_id": {
    "$oid": "644395ffe73ff90013f3b019"
  },
  "createdTs": null,
  "updatedTs": 1782125299,
  "updatedBy": "640989a122333e4cfb043150",
  "createdBy": null,
  "id": "644395ffe73ff90013f3b019",
  "book": 12,
  "chapter": 7,
  "verse": 6,
  "content": [
    {
      "txt": "이는 "
    },
    {
      "txt": "주",
      "link": "623b10058f55f4001421998c"
    },
    {
      "txt": "께서 "
    },
    {
      "txt": "아람",
      "link": "61b1b7e33b8fc5001467adce"
    },
    {
      "txt": " 군대로 "
    },
    {
      "txt": "병거",
      "link": "6187db70ab886400139a72de"
    },
    {
      "txt": " 소리와 말 소리와 큰 군대의 소리를 듣게 하셨으므로 "
    },
    {
      "txt": "아람 사람",
      "link": "63f9b214155c55001474f90d"
    },
    {
      "txt": "이 서로 말하기를 "
    },
    {
      "txt": "이스라엘",
      "link": "60c71f046cfae70012b03764"
    },
    {
      "txt": " "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": "이 우리를 치려하여 헷 사람의 "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": "들과 "
    },
    {
      "txt": "애굽",
      "link": "60feb3851ef2ea00133538cc"
    },
    {
      "txt": " "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": "들에게 값을 "
    },
    {
      "txt": "주"
    },
    {
      "txt": "고 저희로 우리에게 오게 하였다 하고"
    }
  ],
  "result": null,
  "deploy": "off",
  "script": "이는 주께서 아람 군대로 병거 소리와 말 소리와 큰 군대의 소리를 듣게 하셨으므로 아람 사람이 서로 말하기를 이스라엘 왕이 우리를 치려하여 헷 사람의 왕들과 애굽 왕들에게 값을 주고 저희로 우리에게 오게 하였다 하고",
