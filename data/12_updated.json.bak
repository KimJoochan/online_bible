      "link": "60bb1fb41376e50012a0db28"
    },
    {
      "txt": "이 "
    },
    {
      "txt": "주",
      "link": "623b10058f55f4001421998c"
    },
    {
      "txt": " "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "는 홀로 "
    },
    {
      "txt": "하나님",
      "link": "60ba24261376e50012a0da8a"
    },
    {
      "txt": "이신줄 알리이다 하니라"
    }
  ],
  "result": null,
  "deploy": "off",
