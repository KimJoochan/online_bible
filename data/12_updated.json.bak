{
  "_id": {
    "$oid": "644395ffe73ff90013f3af6d"
  },
  "createdTs": null,
  "updatedTs": 1782125299,
  "updatedBy": "640989a122333e4cfb043150",
  "createdBy": null,
  "id": "644395ffe73ff90013f3af6d",
  "book": 12,
  "chapter": 1,
  "verse": 8,
  "content": [
    {
      "txt": "저희가 대답하되 그는 <span style=\"color:Blue;\">ᵃ</span>털이 많은 사람인데 "
    },
    {
      "txt": "허리",
      "link": "648f17e98d26fb00138801bb"
    },
    {
