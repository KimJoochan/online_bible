    },
    {
      "txt": "에 "
    },
    {
      "txt": "예물",
      "link": "63f0fa71155c55001474f7a8"
    },
    {
      "txt": "을 가지고 가서 "
    },
    {
      "txt": "하나님",
      "link": "60ba24261376e50012a0da8a"
    },
    {
      "txt": "의 사람을 맞고 저로 말미암아 "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "께 나의 이 병이 낫겠나 물으라"
    }
