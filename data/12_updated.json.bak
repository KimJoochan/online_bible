{
  "_id": {
    "$oid": "644395ffe73ff90013f3afed"
  },
  "createdTs": null,
  "updatedTs": 1782125299,
  "updatedBy": "640989a122333e4cfb043150",
  "createdBy": null,
  "id": "644395ffe73ff90013f3afed",
  "book": 12,
  "chapter": 5,
  "verse": 22,
  "content": [
    {
      "txt": "저가 가로되 "
    },
    {
      "txt": "평안",
      "link": "648853a7ba956c0013dc1796"
    },
    {
      "txt": "이니이다 우리 "
    },
    {
      "txt": "주인",
      "link": "64676ca8ba956c0013dc1468"
    },
    {
      "txt": "께서 나를 보내시며 말씀하시기를 지금 "
    },
    {
      "txt": "선지자",
      "link": "6145de9d5f803400131d4a12"
    },
    {
      "txt": "의 "
    },
    {
      "txt": "생도",
      "link": "63c4841e6f82e70014841bef"
    },
    {
      "txt": " 중에 두 소년이 "
    },
    {
      "txt": "에브라임",
      "link": "6453c04dba956c0013dc133f"
    },
    {
      "txt": " "
    },
    {
      "txt": "산지",
      "link": "63cb22906f82e70014841cbf"
    },
    {
      "txt": "에서부터 내게 왔으니 청컨대 당신"
    },
    {
      "txt": "은"
    },
    {
      "txt": " 저희에게 "
    },
    {
      "txt": "은",
      "link": "63f0cd8b155c55001474f781"
    },
    {
      "txt": " 한 "
    },
    {
      "txt": "달란트",
      "link": "623df6128f55f400142199b2"
    },
    {
      "txt": "와 "
    },
    {
      "txt": "옷",
      "link": "60bcc2161376e50012a0db81"
    },
    {
      "txt": " 두 벌을 주라 하시더이다"
    }
  ],
  "result": null,
  "deploy": "off",
  "script": "저가 가로되 평안이니이다 우리 주인께서 나를 보내시며 말씀하시기를 지금 선지자의 생도 중에 두 소년이 에브라임 산지에서부터 내게 왔으니 청컨대 당신은 저희에게 은 한 달란트와 옷 두 벌을 주라 하시더이다",
  "link_pos": [
    {
      "start": 7,
      "end": 8,
      "href": "/bible-forest/dictionary/648853a7ba956c0013dc1796"
    },
    {
