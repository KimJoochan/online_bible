    },
    {
      "txt": "의 집 곁에 있던 것이며 또 "
    },
    {
      "txt": "태양"
    },
    {
      "txt": " "
    },
    {
      "txt": "수레",
      "link": "63b6ad746f82e70014841a27"
    },
    {
      "txt": "를 "
    },
    {
      "txt": "불",
      "link": "633d78296f82e7001484127a"
    },
    {
      "txt": "사르고"
    }
  ],
  "result": null,
  "deploy": "off",
