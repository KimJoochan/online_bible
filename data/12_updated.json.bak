    {
      "txt": "를 신임하여 "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": " 보시기에 악을 많이 행하여 그 "
    },
    {
      "txt": "진노",
      "link": "648a5cabba956c0013dc17bd"
    },
    {
      "txt": "를 격발하였으며"
    }
  ],
  "result": null,
