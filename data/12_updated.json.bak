  "chapter": 10,
  "verse": 10,
  "content": [
    {
      "txt": "그런즉 너희는 알라 곧 "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "께서 "
