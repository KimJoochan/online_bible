  "content": [
    {
      "txt": "아와",
      "link": "63e27244155c55001474f635"
    },
    {
      "txt": " 사람들은 "
    },
    {
      "txt": "닙하스",
      "link": "630209a4f7b0360013928f63"
    },
    {
      "txt": "와 "
    },
    {
      "txt": "다르닥",
      "link": "6325218d6f82e70014841144"
    },
    {
      "txt": "을 만들었고 "
    },
    {
      "txt": "스발와임",
      "link": "63d0f0e16f82e70014841d1f"
    },
    {
      "txt": " 사람들은 그 "
    },
    {
      "txt": "자녀",
      "link": "647220f9ba956c0013dc155c"
    },
    {
      "txt": "를 "
    },
    {
      "txt": "불",
      "link": "633d78296f82e7001484127a"
    },
    {
      "txt": "살라 그 신 "
    },
    {
      "txt": "아드람멜렉",
      "link": "643de756e73ff90013f2970a"
    },
    {
      "txt": "과 "
    },
    {
      "txt": "아남멜렉",
      "link": "640319aacc90a400169b1fe3"
    },
    {
      "txt": "에게 드렸으며"
    }
  ],
  "result": null,
  "deploy": "off",
  "script": "아와 사람들은 닙하스와 다르닥을 만들었고 스발와임 사람들은 그 자녀를 불살라 그 신 아드람멜렉과 아남멜렉에게 드렸으며",
  "link_pos": [
