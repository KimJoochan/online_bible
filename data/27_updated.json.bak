{
  "_id": {
    "$oid": "644395ffe73ff90013f3df20"
  },
  "createdTs": null,
  "updatedTs": 1782219100,
  "updatedBy": "640989a122333e4cfb043150",
  "createdBy": null,
  "id": "644395ffe73ff90013f3df20",
  "book": 27,
  "chapter": 1,
  "verse": 15,
  "content": [
    {
      "txt": "열흘",
      "link": "6407282dcc90a400169b2040"
    },
    {
      "txt": " 후에 그들의 얼굴이 더욱 아름답고 살이 더욱 윤택하여 "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
