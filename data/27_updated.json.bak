{
  "_id": {
    "$oid": "644395ffe73ff90013f3e040"
  },
  "createdTs": null,
  "updatedTs": 1782219101,
  "updatedBy": "640989a122333e4cfb043150",
  "createdBy": null,
  "id": "644395ffe73ff90013f3e040",
  "book": 27,
  "chapter": 11,
  "verse": 4,
  "content": [
    {
      "txt": "그러나 그가 강성할 때에 그 "
    },
    {
      "txt": "나라",
      "link": "60ba1bcc1376e50012a0da54"
    },
    {
      "txt": "가 갈라져 천하 사방에 나누일 것이나 그 "
    },
    {
      "txt": "자손",
      "link": "6460f5eaba956c0013dc13e5"
    },
    {
      "txt": "에게로 돌아가지도 아니할 것이요 또 자기가 주장하던 "
    },
    {
      "txt": "권세",
      "link": "62adee028f55f40014219cd3"
    },
    {
      "txt": "대로도 되지 아니하리니 이는 그 "
    },
    {
      "txt": "나라",
      "link": "60ba1bcc1376e50012a0da54"
    },
    {
      "txt": "가 뽑혀서 이 외의 사람들에게로 돌아갈 것임이니라"
    }
  ],
  "result": null,
  "deploy": "off",
  "script": "그러나 그가 강성할 때에 그 나라가 갈라져 천하 사방에 나누일 것이나 그 자손에게로 돌아가지도 아니할 것이요 또 자기가 주장하던 권세대로도 되지 아니하리니 이는 그 나라가 뽑혀서 이 외의 사람들에게로 돌아갈 것임이니라",
  "link_pos": [
