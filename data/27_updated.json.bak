    {
      "txt": "양",
      "link": "60ba2ce91376e50012a0dab1"
    },
    {
      "txt": "의 "
    },
    {
      "txt": "털",
      "link": "6462c76dba956c0013dc1403"
    },
    {
      "txt": " 같고 그 "
    },
    {
      "txt": "보좌",
      "link": "60ba23ed1376e50012a0da87"
    },
    {
      "txt": "는 "
    },
    {
      "txt": "불"
    },
    {
      "txt": "꽃이요 그 "
    },
    {
      "txt": "바퀴",
      "link": "63e10c42155c55001474f61d"
    },
    {
      "txt": "는 붙는 "
    },
    {
      "txt": "불",
