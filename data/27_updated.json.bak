    },
    {
      "txt": "에게 또 "
    },
    {
      "txt": "머리",
      "link": "60ba29471376e50012a0daa0"
    },
    {
      "txt": " 넷이 있으며 또 "
    },
    {
      "txt": "권세",
      "link": "62adee028f55f40014219cd3"
    },
    {
      "txt": "를 받았으며"
    }
  ],
