      "link": "647c42c3ba956c0013dc16b9"
    },
    {
      "txt": "와 같은 자라 "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": "의 부친 "
    },
    {
      "txt": "느부갓네살",
      "link": "60becdcc1376e50012a0dbce"
    },
    {
      "txt": " "
    },
    {
      "txt": "왕",
