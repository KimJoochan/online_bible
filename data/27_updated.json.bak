  "content": [
    {
      "txt": "그들이 "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": " 앞에서 대답하여 가로되 "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": "이여 사로잡혀 온 "
    },
    {
      "txt": "유다",
      "link": "618772baab886400139a72d3"
    },
    {
      "txt": " "
    },
    {
      "txt": "자손",
      "link": "6460f5eaba956c0013dc13e5"
    },
    {
      "txt": " 중에 그 "
    },
    {
      "txt": "다니엘",
      "link": "60b9fd611376e50012a0da05"
    },
    {
      "txt": "이 "
    },
