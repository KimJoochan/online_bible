    },
    {
      "txt": " "
    },
    {
      "txt": "술사",
      "link": "63c80af26f82e70014841c93"
    },
    {
      "txt": "들이 "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": " 앞에 대답하여 가로되 "
    },
