    },
    {
      "txt": "에 깃들이고 무릇 혈기 있는 자가 거기서 "
    },
    {
      "txt": "식물",
      "link": "63d799ca71ef9d001487b57e"
    },
    {
      "txt": "을 얻더라"
    }
  ],
  "result": null,
  "deploy": "off",
