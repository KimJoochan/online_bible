    {
      "txt": "하나님",
      "link": "60ba24261376e50012a0da8a"
    },
    {
      "txt": "이 다스리시는 줄을 "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": "이 깨달은 후에야 "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": "의 "
    },
    {
      "txt": "나라",
      "link": "60ba1bcc1376e50012a0da54"
    },
    {
      "txt": "가 견고하리이다"
    }
  ],
  "result": null,
