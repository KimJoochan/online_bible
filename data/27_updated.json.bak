{
  "_id": {
    "$oid": "644395ffe73ff90013f3df88"
  },
  "createdTs": null,
  "updatedTs": 1782219100,
  "updatedBy": "640989a122333e4cfb043150",
  "createdBy": null,
  "id": "644395ffe73ff90013f3df88",
  "book": 27,
  "chapter": 4,
  "verse": 19,
  "content": [
    {
      "txt": "벨드사살"
    },
    {
      "txt": "이라 이름한 "
    },
    {
      "txt": "다니엘",
      "link": "60b9fd611376e50012a0da05"
    },
    {
      "txt": "이 얼마 동안 놀라 벙벙하며 마음이 "
    },
    {
      "txt": "번민",
      "link": "64c8f5303d393400137962df"
    },
    {
      "txt": "하여 하는지라 "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": "이 그에게 말하여 이르기를 "
    },
    {
      "txt": "벨드사살"
    },
    {
      "txt": "아 너는 이 "
    },
    {
      "txt": "꿈",
      "link": "62c13a128f55f40014219e53"
    },
    {
      "txt": "과 그 "
    },
    {
      "txt": "해석",
      "link": "648c2fe18d26fb0013880162"
    },
    {
      "txt": "을 인하여 "
    },
    {
      "txt": "번민",
      "link": "64c8f5303d393400137962df"
    },
    {
      "txt": "할 것이 아니니라 "
    },
    {
      "txt": "벨드사살",
      "link": "63a3d06a6f82e700148417be"
    },
    {
      "txt": "이 대답하여 가로되 내"
    },
    {
      "txt": " 주",
      "link": "623b10058f55f4001421998c"
    },
    {
      "txt": "여 그 "
    },
    {
      "txt": "꿈",
      "link": "62c13a128f55f40014219e53"
    },
    {
      "txt": "은 "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": "을 미워하는 자에게 응하기를 원하며 그 "
    },
    {
      "txt": "해석",
      "link": "648c2fe18d26fb0013880162"
    },
    {
      "txt": "은 "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": "의 "
    },
    {
      "txt": "대적",
      "link": "6237d8a38f55f4001421996c"
    },
    {
      "txt": "에게 응하기를 원하나이다"
    }
  ],
  "result": null,
  "deploy": "off",
  "script": "벨드사살이라 이름한 다니엘이 얼마 동안 놀라 벙벙하며 마음이 번민하여 하는지라 왕이 그에게 말하여 이르기를 벨드사살아 너는 이 꿈과 그 해석을 인하여 번민할 것이 아니니라 벨드사살이 대답하여 가로되 내 주여 그 꿈은 왕을 미워하는 자에게 응하기를 원하며 그 해석은 왕의 대적에게 응하기를 원하나이다",
  "link_pos": [
