    },
    {
      "txt": "를 찍고 그 "
    },
    {
      "txt": "잎사귀",
      "link": "60ba33371376e50012a0dac9"
    },
    {
      "txt": "를 떨고 그 "
    },
    {
      "txt": "열매",
      "link": "60ba29a51376e50012a0daa6"
    },
    {
      "txt": "를 헤치고 "
    },
    {
      "txt": "짐승",
      "link": "60bb07541376e50012a0db23"
    },
    {
      "txt": "들로 그 아래서 떠나게 하고 "
    },
    {
      "txt": "새",
      "link": "60ba2ab41376e50012a0daa8"
    },
    {
      "txt": "들을 그 가지에서 쫓아내라"
    }
  ],
