    },
    {
      "txt": "이라 모든 "
    },
    {
      "txt": "권세",
      "link": "62adee028f55f40014219cd3"
    },
    {
      "txt": " 있는 자가 다 그를 섬겨 "
    },
    {
      "txt": "복종",
      "link": "63b6c04d6f82e70014841a2d"
