  "book": 27,
  "chapter": 4,
  "verse": 21,
  "content": [
    {
      "txt": "그 "
    },
    {
      "txt": "잎사귀",
      "link": "60ba33371376e50012a0dac9"
    },
    {
      "txt": "는 아름답고 그 "
    },
    {
      "txt": "열매",
      "link": "60ba29a51376e50012a0daa6"
    },
    {
      "txt": "는 많아서 만민의 "
    },
    {
      "txt": "식물",
      "link": "63d799ca71ef9d001487b57e"
    },
    {
      "txt": "이 될만하고 "
    },
    {
      "txt": "들짐승",
      "link": "618949adab886400139a7305"
    },
    {
      "txt": "은 그 아래 거하며 "
    },
    {
      "txt": "공중",
      "link": "60c4b44e6cfae70012b0373f"
    },
    {
      "txt": "에 나는 "
    },
    {
      "txt": "새",
      "link": "60ba2ab41376e50012a0daa8"
    },
    {
      "txt": "는 그 "
    },
    {
      "txt": "가지",
      "link": "611fbfd5e8113c001ae0b4ab"
    },
    {
      "txt": "에 깃들이더라 하시오니"
    }
  ],
  "result": null,
  "deploy": "off",
  "script": "그 잎사귀는 아름답고 그 열매는 많아서 만민의 식물이 될만하고 들짐승은 그 아래 거하며 공중에 나는 새는 그 가지에 깃들이더라 하시오니",
