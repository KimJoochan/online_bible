    },
    {
      "txt": "에게 알려서 "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": "의 마음으로 생각하던 것을 "
    },
    {
      "txt": "왕",
      "link": "60b9fd141376e50012a0da00"
    },
    {
      "txt": "으로 알게하려 하심이니이다"
    }
  ],
  "result": null,
