  "book": 27,
  "chapter": 11,
  "verse": 2,
  "content": [
    {
      "txt": "이제 내가 참된 것을 네게 보이리라 "
    },
    {
      "txt": "보라",
      "link": "63c806686f82e70014841c8d"
