  "chapter": 2,
  "verse": 30,
  "content": [
    {
      "txt": "내게 이 "
    },
    {
      "txt": "은밀",
      "link": "63f0d51b155c55001474f788"
    },
    {
      "txt": "한 것을 나타내심은 내 "
    },
