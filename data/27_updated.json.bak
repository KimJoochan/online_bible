    {
      "txt": " "
    },
    {
      "txt": "다니엘",
      "link": "60b9fd611376e50012a0da05"
    },
    {
      "txt": "아 너의 항상 섬기는 네 "
    },
    {
      "txt": "하나님",
      "link": "60ba24261376e50012a0da8a"
    },
    {
      "txt": "이 "
    },
    {
      "txt": "사자",
      "link": "63de74c5155c55001474f5bd"
    },
    {
      "txt": "에게서 너를 "
    },
    {
      "txt": "구원",
      "link": "618f9f7aab04fd00148cc58c"
    },
    {
      "txt": "하시기에 능하셨느냐"
    }
  ],
