  "content": [
    {
      "txt": "그러나 "
    },
    {
      "txt": "이스라엘",
      "link": "60c71f046cfae70012b03764"
    },
    {
      "txt": " "
    },
    {
      "txt": "자손",
      "link": "6460f5eaba956c0013dc13e5"
    },
    {
      "txt": "의 "
    },
    {
      "txt": "수",
      "link": "63ad9df96f82e70014841983"
    },
    {
      "txt": "가 <span style=\"color:crimson;\">¹</span>바닷가의 "
    },
    {
      "txt": "모래",
      "link": "6377769c6f82e70014841594"
    },
    {
      "txt": " 같이 되어서 측량할 "
