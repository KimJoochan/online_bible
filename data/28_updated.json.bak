  "content": [
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "께서 비로소 "
    },
    {
      "txt": "호세아",
      "link": "60ba085a1376e50012a0da24"
    },
    {
      "txt": "로 "
    },
    {
      "txt": "말씀",
      "link": "62356e018f55f4001421995c"
    },
    {
      "txt": "하시니라 "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "께서 "
    },
    {
      "txt": "호세아",
      "link": "60ba085a1376e50012a0da24"
    },
    {
      "txt": "에게 이르시되 너는 가서 "
    },
    {
      "txt": "음란",
      "link": "61f546f721976e001389d9a1"
    },
    {
      "txt": "한 "
    },
    {
      "txt": "아내",
      "link": "60bbaf581376e50012a0db62"
    },
    {
      "txt": "를 취하여 "
    },
    {
      "txt": "음란",
      "link": "61f546f721976e001389d9a1"
    },
    {
      "txt": "한 "
    },
    {
      "txt": "자식",
      "link": "6455f2f2ba956c0013dc134c"
    },
    {
      "txt": "들을 낳으라 이 "
    },
    {
      "txt": "나라",
