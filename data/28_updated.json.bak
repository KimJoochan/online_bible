  "chapter": 4,
  "verse": 13,
  "content": [
    {
      "txt": "저희가 "
    },
    {
      "txt": "산",
      "link": "60ba1bb11376e50012a0da53"
    },
    {
      "txt": " 꼭대기에서 "
    },
    {
      "txt": "제사",
      "link": "61546ad2fca7a4001a586e16"
    },
    {
      "txt": "를 드리며 작은 "
    },
    {
      "txt": "산",
      "link": "60ba1bb11376e50012a0da53"
    },
    {
      "txt": " 위에서 분향하되 참"
    },
    {
      "txt": "나무",
      "link": "60ba1d581376e50012a0da5e"
    },
    {
      "txt": "와 "
    },
    {
      "txt": "버드나무",
