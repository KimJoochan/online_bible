      "txt": "아침",
      "link": "640fee37050c7b001378e8eb"
    },
    {
      "txt": "에 피우는 "
    },
    {
      "txt": "불",
      "link": "633d78296f82e7001484127a"
    },
    {
      "txt": "의 일어나는 것 같도다"
    }
  ],
  "result": null,
