      "link": "60ba12271376e50012a0da31"
    },
    {
      "txt": "이랑에 쌓인 "
    },
    {
      "txt": "돌무더기",
      "link": "6321f79d6f82e70014841100"
    },
    {
      "txt": " 같도다"
    }
  ],
