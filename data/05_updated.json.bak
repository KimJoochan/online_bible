    },
    {
      "txt": "이든지 "
    },
    {
      "txt": "조각",
      "link": "646263f6ba956c0013dc13fe"
    },
    {
      "txt": "하여 네 "
    },
    {
      "txt": "하나님",
      "link": "60ba24261376e50012a0da8a"
    },
    {
      "txt": " "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": " 앞에 악을 행함으로 그의 노를 격발하면"
    }
  ],
  "result": null,
  "deploy": "off",
