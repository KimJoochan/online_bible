    },
    {
      "txt": "이나 네 "
    },
    {
      "txt": "문",
      "link": "6370eeb46f82e70014841540"
    },
    {
      "txt": " 안에 유하는 객이라도 아무 일도 하지 말고 네 "
    },
    {
      "txt": "남종",
      "link": "6300e45ef7b0360013928f3f"
    },
    {
      "txt": "이나 네 "
    },
    {
      "txt": "여종",
      "link": "63f5c974155c55001474f866"
    },
    {
      "txt": "으로 너 같이 "
    },
    {
      "txt": "안식",
      "link": "622cabb68f55f40014219949"
    },
    {
      "txt": "하게 할지니라"
    }
  ],
  "result": null,
  "deploy": "off",
