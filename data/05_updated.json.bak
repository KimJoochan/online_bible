  "content": [
    {
      "txt": "그런즉 너는 알라 오직 네 "
    },
    {
      "txt": "하나님",
      "link": "60ba24261376e50012a0da8a"
    },
    {
      "txt": " "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "는 "
    },
    {
      "txt": "하나님",
      "link": "60ba24261376e50012a0da8a"
    },
    {
      "txt": "이시요 "
    },
    {
      "txt": "신실",
      "link": "624a8f7e8f55f40014219a01"
    },
    {
