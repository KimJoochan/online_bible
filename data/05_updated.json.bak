  "content": [
    {
      "txt": "그 때에 "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "께서 "
    },
    {
      "txt": "레위",
      "link": "6121eb5ee8113c001ae0b4b1"
    },
    {
      "txt": " "
    },
    {
      "txt": "지파",
      "link": "61b74c623b8fc5001467ae49"
    },
    {
      "txt": "를 구별하여 "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
