    },
    {
      "txt": "이 <span style=\"color:Blue;\">ᵃ</span>"
    },
    {
      "txt": "브에롯 브네야아간",
      "link": "63a6e18b6f82e7001484184f"
    },
    {
      "txt": "에서 "
    },
