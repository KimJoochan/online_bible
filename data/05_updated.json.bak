    },
    {
      "txt": "의 "
    },
    {
      "txt": "안식",
      "link": "622cabb68f55f40014219949"
    },
    {
      "txt": "인즉 너나 네 "
    },
    {
      "txt": "아들",
      "link": "643e24b2e73ff90013f2970d"
    },
    {
      "txt": "이나 네 딸이나 네 "
    },
    {
      "txt": "남종",
      "link": "6300e45ef7b0360013928f3f"
    },
    {
      "txt": "이나 네 "
    },
    {
      "txt": "여종",
      "link": "63f5c974155c55001474f866"
    },
    {
      "txt": "이나 네 소나 네 "
    },
    {
      "txt": "나귀",
      "link": "62f52abc55b278001668dd41"
    },
    {
      "txt": "나 네 모든 "
    },
    {
      "txt": "육축",
