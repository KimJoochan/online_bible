  "content": [
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "께서 "
    },
    {
      "txt": "모세",
      "link": "60b9fe5f1376e50012a0da0d"
    },
    {
      "txt": "에게 이르시되 너의 죽을 기한이 가까웠으니 "
    },
    {
      "txt": "여호수아",
      "link": "60ba37811376e50012a0dadb"
    },
    {
      "txt": "를 불러서 함께 "
    },
    {
      "txt": "회막",
      "link": "62cd63a88f55f40014219edc"
    },
    {
      "txt": "으로 나아오라 내가 그에게 명을 내리리라 "
    },
    {
      "txt": "모세",
      "link": "60b9fe5f1376e50012a0da0d"
    },
    {
      "txt": "와 여호수아가 나아가서 "
    },
    {
      "txt": "회막"
    },
    {
      "txt": "에 서니"
    }
  ],
  "result": null,
  "deploy": "off",
