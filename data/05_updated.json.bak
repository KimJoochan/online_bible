    {
      "txt": " "
    },
    {
      "txt": "멍에",
      "link": "635d44416f82e70014841418"
    },
    {
      "txt": "를 네 목에 메워서 필경 너를 멸할 것이라"
    }
  ],
  "result": null,
  "deploy": "off",
