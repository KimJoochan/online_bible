      "link": "63cb22906f82e70014841cbf"
    },
    {
      "txt": " 길로 "
    },
    {
      "txt": "가데스 바네아",
      "link": "62b867c38f55f40014219d95"
    },
    {
      "txt": "에 이른 때에"
    }
  ],
  "result": null,
  "deploy": "off",
