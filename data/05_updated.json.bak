  "verse": 15,
  "content": [
    {
      "txt": "그러한데 <span style=\"color:crimson;\">¹</span>"
    },
    {
      "txt": "여수룬",
      "link": "63f5692f155c55001474f85b"
    },
    {
      "txt": "이 살찌매 "
    },
    {
      "txt": "발",
      "link": "63a85c9d6f82e700148418ee"
    },
    {
      "txt": "로 찼도다 네가 살찌고 "
    },
    {
      "txt": "부대",
      "link": "637f1f636f82e700148415c0"
    },
    {
      "txt": "하고 윤택하매 자기를 지으신 "
    },
    {
      "txt": "하나님",
      "link": "60ba24261376e50012a0da8a"
    },
    {
      "txt": "을 버리며 자기를 "
    },
    {
      "txt": "구원",
      "link": "618f9f7aab04fd00148cc58c"
    },
    {
      "txt": "하신 "
    },
    {
      "txt": "반석",
      "link": "61894a88ab886400139a7308"
    },
    {
      "txt": "을 경홀히 여겼도다"
    }
  ],
  "result": null,
  "deploy": "off",
