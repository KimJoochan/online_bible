      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "의 "
    },
    {
      "txt": "공의",
      "link": "62bd62028f55f40014219de2"
    },
    {
      "txt": "와 "
    },
    {
      "txt": "이스라엘",
      "link": "60c71f046cfae70012b03764"
    },
    {
      "txt": "과 세우신 법도를 행하도다"
    }
  ],
  "result": null,
  "deploy": "off",
