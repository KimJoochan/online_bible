  "book": 5,
  "chapter": 5,
  "verse": 5,
  "content": [
    {
      "txt": "그 때에 너희가 <span style=\"color:crimson;\">¹</span>"
    },
    {
      "txt": "불",
      "link": "633d78296f82e7001484127a"
    },
    {
      "txt": "을 두려워하여 "
    },
    {
      "txt": "산",
      "link": "60ba1bb11376e50012a0da53"
    },
    {
      "txt": "에 오르지 못하므로 내가 "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "와 너희 중간에 서서 "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "의 "
    },
    {
      "txt": "말씀",
      "link": "62356e018f55f4001421995c"
    },
    {
      "txt": "을 너희에게 전하였노라 "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "께서 "
    },
    {
      "txt": "가라사대",
      "link": "62b7209c8f55f40014219d70"
    }
  ],
  "result": null,
  "deploy": "off",
