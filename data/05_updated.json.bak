    },
    {
      "txt": "로 쳐 죽일 것이니 그 "
    },
    {
      "txt": "처녀",
      "link": "64737565ba956c0013dc1580"
    },
    {
      "txt": "는 "
    },
    {
      "txt": "성읍",
      "link": "626eacac8f55f40014219ab2"
    },
    {
