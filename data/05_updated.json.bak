    },
    {
      "txt": " "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "께 고하나이다 내가 "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "께서 우리에게 주리라고 우리 "
    },
    {
      "txt": "열조",
      "link": "640719ffcc90a400169b203f"
    },
    {
      "txt": "에게 "
    },
    {
      "txt": "맹세",
      "link": "62dd55468f55f40014219f68"
    },
    {
      "txt": "하신 땅에 이르렀나이다 할 것이요"
    }
  ],
  "result": null,
