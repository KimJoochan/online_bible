  "link_deploy": "on",
  "edit_script": "여호와께서 그로 땅의 높은 곳을 타고 다니게 하시며 밭의 소산을 먹게 하시며 반석에서 꿀을, 굳은 반석에서 기름을 빨게 하시며",
  "edit_deploy": "on"
},
