{
  "_id": {
    "$oid": "644395ffe73ff90013f3a0ab"
  },
  "createdTs": null,
  "updatedTs": 1769340294,
  "updatedBy": "640989a122333e4cfb043150",
  "createdBy": null,
  "id": "644395ffe73ff90013f3a0ab",
  "book": 5,
  "chapter": 32,
  "verse": 4,
  "content": [
    {
      "txt": "그는 <span style=\"color:crimson;\">¹</span>"
    },
    {
      "txt": "반석",
      "link": "61894a88ab886400139a7308"
    },
    {
      "txt": "이시니 그 공"
    },
    {
      "txt": "덕",
      "link": "632e536e6f82e7001484120f"
    },
    {
      "txt": "이 완전하고 그 모든 길이 공평하며 "
    },
    {
      "txt": "진실",
      "link": "648a6949ba956c0013dc17c3"
    },
    {
      "txt": "무망하신 "
    },
    {
      "txt": "하나님",
      "link": "60ba24261376e50012a0da8a"
    },
    {
      "txt": "이시니 "
    },
    {
      "txt": "공의",
      "link": "62bd62028f55f40014219de2"
    },
    {
      "txt": "로우시고 "
    },
    {
      "txt": "정직",
      "link": "646f9250ba956c0013dc1520"
