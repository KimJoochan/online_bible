  "verse": 11,
  "content": [
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "여 그 "
    },
    {
      "txt": "재산",
      "link": "64573cd1ba956c0013dc1358"
    },
    {
      "txt": "을 풍족케 하시고 그 "
    },
    {
      "txt": "손",
      "link": "63c817386f82e70014841c9d"
    },
    {
      "txt": "의 일을 받으소서 그를 "
    },
    {
      "txt": "대적",
      "link": "6237d8a38f55f4001421996c"
    },
    {
      "txt": "하여 일어나는 자와 미워하는 자의 "
    },
    {
      "txt": "허리",
      "link": "648f17e98d26fb00138801bb"
    },
    {
      "txt": "를 꺾으사 다시 일어나지 못하게 하옵소서"
    }
  ],
  "result": null,
  "deploy": "off",
