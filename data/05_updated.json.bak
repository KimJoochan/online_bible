  "chapter": 29,
  "verse": 23,
  "content": [
    {
      "txt": "그 온 땅이 "
    },
    {
      "txt": "유황",
      "link": "618a8680c5894b001b8c5c1e"
    },
    {
      "txt": "이 되며 "
    },
    {
      "txt": "소금",
