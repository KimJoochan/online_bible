    },
    {
      "txt": "을 그 위에 기록하라 그리하면 네 "
    },
    {
      "txt": "하나님",
      "link": "60ba24261376e50012a0da8a"
    },
    {
      "txt": " "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "께서 네게 주시는 땅 곧 "
    },
    {
      "txt": "젖",
      "link": "6229c67f8f55f40014219938"
    },
    {
      "txt": "과 꿀이 흐르는 땅에 네가 들어가기를 네 "
    },
    {
      "txt": "열조",
      "link": "640719ffcc90a400169b203f"
    },
    {
      "txt": "의 "
    },
    {
      "txt": "하나님",
      "link": "60ba24261376e50012a0da8a"
    },
    {
      "txt": " "
    },
    {
      "txt": "여호와",
