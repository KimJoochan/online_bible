    },
    {
      "txt": " "
    },
    {
      "txt": "그리스도",
      "link": "6143526d5f803400131d49da"
    },
    {
      "txt": " "
    },
    {
      "txt": "예수",
      "link": "60f3efbd1ef2ea001335389b"
    },
    {
      "txt": " 안에 있는 "
    },
    {
      "txt": "하나님",
      "link": "60ba24261376e50012a0da8a"
    },
    {
      "txt": "의 "
    },
    {
      "txt": "사랑",
      "link": "623965718f55f40014219978"
    },
    {
      "txt": "에서 끊을 수 없으리라"
    }
  ],
  "result": null,
  "deploy": "off",
  "script": "높음이나 깊음이나 다른 아무 피조물이라도 우리를 우리 주 그리스도 예수 안에 있는 하나님의 사랑에서 끊을 수 없으리라",
