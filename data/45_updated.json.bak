      "link": "64df53693d39340013796348"
    },
    {
      "txt": "하지 말라 이는 "
    },
    {
      "txt": "하나님",
      "link": "60ba24261376e50012a0da8a"
    },
    {
      "txt": "이 저를 받으셨음이니라"
    }
  ],
  "result": null,
  "deploy": "off",
