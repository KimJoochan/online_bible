    },
    {
      "txt": "을 세우신 것과 "
    },
    {
      "txt": "예배",
      "link": "614446055f803400131d49df"
    },
    {
      "txt": "와 <span style=\"color:crimson;\">²</span>"
    },
    {
      "txt": "약속",
      "link": "61d6ee3921976e001389d958"
    },
    {
