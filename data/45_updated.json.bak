{
  "_id": {
    "$oid": "644395ffe73ff90013f3f828"
  },
  "createdTs": null,
  "updatedTs": 1782220947,
  "updatedBy": "640989a122333e4cfb043150",
  "createdBy": null,
  "id": "644395ffe73ff90013f3f828",
  "book": 45,
  "chapter": 9,
  "verse": 5,
  "content": [
    {
      "txt": "조상",
      "link": "6466fefeba956c0013dc144a"
    },
    {
      "txt": "들도 저희 것이요 육신으로 하면 "
    },
    {
      "txt": "그리스도",
      "link": "6143526d5f803400131d49da"
    },
    {
      "txt": "가 저희에게서 나셨으니 <span style=\"color:Blue;\">ᵃ</span>저는 "
    },
    {
      "txt": "만물",
      "link": "6236c6fd8f55f40014219965"
    },
    {
      "txt": " 위에 계셔 "
    },
    {
      "txt": "세세",
      "link": "63cb7b986f82e70014841ce5"
    },
    {
      "txt": "에 "
    },
    {
      "txt": "찬양",
      "link": "64eee65db2756c0013086eca"
    },
    {
      "txt": "을 받으실 "
    },
    {
      "txt": "하나님",
