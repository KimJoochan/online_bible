  "content": [
    {
      "txt": "<span style=\"color:crimson;\">¹</span>"
    },
    {
      "txt": "간음",
      "link": "618a841cc5894b001b8c5c18"
    },
    {
      "txt": "하지 말라, "
    },
    {
      "txt": "살인",
