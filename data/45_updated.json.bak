    },
    {
      "txt": "에는 <span style=\"color:crimson;\">¹</span>"
    },
    {
      "txt": "하나님",
      "link": "60ba24261376e50012a0da8a"
    },
    {
      "txt": "의 의가 나타나서 "
    },
    {
      "txt": "믿음",
      "link": "638785616f82e7001484161a"
    },
    {
      "txt": "으로 "
    },
    {
      "txt": "믿음",
      "link": "638785616f82e7001484161a"
    },
    {
      "txt": "에 이르게 하나니 기록된 바 오직 <span style=\"color:crimson;\">²</span>의인은 "
    },
    {
      "txt": "믿음",
      "link": "638785616f82e7001484161a"
    },
    {
      "txt": "으로 말미암아 살리라 함과 같으니라"
    }
  ],
  "result": null,
  "deploy": "off",
