  "chapter": 9,
  "verse": 16,
  "content": [
    {
      "txt": "이 "
    },
    {
      "txt": "날",
      "link": "62f752c855b278001668dd67"
    },
    {
      "txt": "에 그들의 "
    },
    {
      "txt": "하나님",
      "link": "60ba24261376e50012a0da8a"
    },
    {
      "txt": " "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "께서 그들을 자기 "
    },
    {
      "txt": "백성",
      "link": "60e19c269ca3f400122354c2"
    },
    {
      "txt": "의 "
    },
    {
      "txt": "양",
      "link": "60ba2ce91376e50012a0dab1"
    },
    {
      "txt": "떼 같이 "
    },
    {
      "txt": "구원",
      "link": "618f9f7aab04fd00148cc58c"
    },
    {
      "txt": "하시리니 그들이 "
    },
    {
      "txt": "면류관",
      "link": "61d4b66321976e001389d93a"
    },
    {
      "txt": "의 "
    },
    {
      "txt": "보석",
      "link": "60be3c2b1376e50012a0dbc4"
    },
    {
      "txt": " 같이 "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "의 땅에 <span style=\"color:Blue;\">ᵃ</span>"
    },
    {
      "txt": "빛",
      "link": "60cf04bf6cfae70012b03774"
    },
    {
      "txt": "나리로다"
    }
  ],
  "result": null,
