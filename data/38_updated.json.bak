      "link": "60e5376bd73fa40012bc3bcd"
    },
    {
      "txt": "과 "
    },
    {
      "txt": "유다",
      "link": "618772baab886400139a72d3"
    },
    {
      "txt": "의 모든 "
    },
    {
      "txt": "솥",
      "link": "63ac56dc6f82e7001484196e"
    },
    {
      "txt": "이 만군의 "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "의 "
    },
    {
      "txt": "성물",
      "link": "63dcb8a2155c55001474f56a"
    },
    {
      "txt": "이 될 것인즉 "
    },
    {
      "txt": "제사",
      "link": "61546ad2fca7a4001a586e16"
    },
    {
      "txt": " 드리는 자가 와서 이 "
    },
    {
      "txt": "솥",
      "link": "63ac56dc6f82e7001484196e"
    },
    {
      "txt": "을 취하여 그 가운데 고기를 삶으리라 그 "
    },
    {
      "txt": "날",
      "link": "62f752c855b278001668dd67"
    },
    {
      "txt": "에는 만군의 "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "의 전에 "
    },
    {
      "txt": "가나안",
      "link": "61851a87ab886400139a72ae"
    },
    {
      "txt": " 사람이 다시 있지 아니하리라"
    }
