    },
    {
      "txt": "에 그의 "
    },
    {
      "txt": "발",
      "link": "63a85c9d6f82e700148418ee"
    },
    {
      "txt": "이 "
    },
    {
      "txt": "예루살렘",
      "link": "60e5376bd73fa40012bc3bcd"
    },
    {
      "txt": " 앞 곧 "
    },
    {
      "txt": "동",
      "link": "63218f1c6f82e700148410e6"
    },
    {
      "txt": "편 "
    },
    {
      "txt": "감람 산",
      "link": "62668a158f55f40014219a7c"
    },
    {
      "txt": "에 서실 것이요 "
    },
    {
      "txt": "감람 산",
      "link": "62668a158f55f40014219a7c"
    },
    {
      "txt": "은 그 한가운데가 "
    },
    {
      "txt": "동",
      "link": "63218f1c6f82e700148410e6"
    },
    {
      "txt": "서로 갈라져 매우 큰 "
    },
    {
      "txt": "골짜기",
      "link": "63fa5b5b155c55001474f976"
    },
    {
      "txt": "가 되어서 "
    },
    {
      "txt": "산",
      "link": "60ba1bb11376e50012a0da53"
    },
    {
      "txt": " 절반은 "
    },
    {
      "txt": "북",
      "link": "63ac56856f82e7001484196c"
    },
    {
      "txt": "으로, 절반은 "
    },
    {
      "txt": "남",
      "link": "63003abaf7b0360013928f26"
    },
    {
      "txt": "으로 옮기고"
    }
  ],
  "result": null,
  "deploy": "off",
  "script": "그 날에 그의 발이 예루살렘 앞 곧 동편 감람 산에 서실 것이요 감람 산은 그 한가운데가 동서로 갈라져 매우 큰 골짜기가 되어서 산 절반은 북으로, 절반은 남으로 옮기고",
