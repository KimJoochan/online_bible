  "chapter": 9,
  "verse": 5,
  "content": [
    {
      "txt": "아스글론",
      "link": "63f0f271155c55001474f7a5"
    },
    {
      "txt": "이 보고 무서워하며 "
    },
    {
      "txt": "가사",
      "link": "629c275b8f55f40014219bb9"
    },
    {
      "txt": "도 심히 아파할 것이며 "
    },
    {
      "txt": "에그론",
      "link": "61b1bef43b8fc5001467add2"
    },
    {
      "txt": "은 그 "
    },
    {
      "txt": "소망",
      "link": "623b36658f55f40014219990"
    },
    {
      "txt": "이 "
    },
    {
      "txt": "수치",
      "link": "63c7abdf6f82e70014841c5a"
    },
    {
      "txt": "가 되므로 역시 그러하리라 가사에는 "
    },
    {
      "txt": "임금",
      "link": "60ba1f021376e50012a0da62"
    },
    {
      "txt": "이 끊칠 것이며 "
    },
    {
      "txt": "아스글론",
      "link": "63f0f271155c55001474f7a5"
    },
    {
      "txt": "에는 거민이 없을 것이며"
    }
  ],
  "result": null,
  "deploy": "off",
  "script": "아스글론이 보고 무서워하며 가사도 심히 아파할 것이며 에그론은 그 소망이 수치가 되므로 역시 그러하리라 가사에는 임금이 끊칠 것이며 아스글론에는 거민이 없을 것이며",
