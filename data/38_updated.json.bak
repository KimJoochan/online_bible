    },
    {
      "txt": " 같이 쏘아내실 것이며"
    },
    {
      "txt": " 주",
      "link": "623b10058f55f4001421998c"
    },
    {
      "txt": " "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "께서 "
    },
    {
      "txt": "나팔",
      "link": "60ccaf016cfae70012b0376e"
    },
    {
      "txt": "을 불리시며 "
