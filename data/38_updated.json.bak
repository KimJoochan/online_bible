  "chapter": 7,
  "verse": 12,
  "content": [
    {
      "txt": "그 마음을 금강석 같게 하여 "
    },
    {
      "txt": "율법",
      "link": "6155b133fca7a4001a586e18"
    },
    {
      "txt": "과 만군의 "
