  "chapter": 4,
  "verse": 6,
  "content": [
    {
      "txt": "그가 내게 일러 가로되 "
    },
    {
      "txt": "여호와",
      "link": "613c3a6ae8113c001ae0b559"
    },
    {
      "txt": "께서 "
    },
    {
      "txt": "스룹바벨",
